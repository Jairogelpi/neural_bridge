# AI Providers - OPENROUTER NATIVE CONFIGURATION
# Configuring OpenRouter as the single universal provider.

# 1. Base URL for OpenRouter
OPENAI_BASE_URL=https://openrouter.ai/api/v1

# 2. Your OpenRouter API Key
# This key powers both text generation and real-time pricing lookups.
# Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-placeholder-your-openrouter-key-here
VITE_OPENROUTER_API_KEY=sk-or-placeholder-your-openrouter-key-here

# 3. Choose your default model
# You can use any model ID from OpenRouter here.
# Recommended: "google/gemini-2.0-flash-001" (fast/cheap), "anthropic/claude-3.5-sonnet" (smart)
OPENAI_MODEL=google/gemini-2.0-flash-001

# Policy Overrides (Optional - Defaults in code are safe, but can be tuned here)
DEFAULT_MAX_CALLS=2
DEFAULT_TOKEN_BUDGET=2000
DEFAULT_MAX_TOKENS_PER_CALL=1200
DEFAULT_STORE_TRANSCRIPT=false
DEFAULT_TRANSCRIPT_TTL_HOURS=24

# Profile & Plan Tuning
PROFILE_CAPTURE_MAX_TURNS=60
PROFILE_CAPTURE_MAX_CHARS=12000
PROFILE_VERIFY_THRESHOLD=0.85
PLAN_FREE_MAX_TOKENS=2000
PLAN_FREE_MAX_DAILY_USD=0.02
PLAN_FREE_MAX_COMPILES=5