{
  "name": "neural-bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "test": "vitest run",
    "demo": "vitest run src/verify_crystal_runtime.test.ts --silent=false",
    "proof": "vitest run src/irrefutable_proof.test.ts --silent=false",
    "compare": "vitest run src/comparative_proof.test.ts --silent=false",
    "ultimate": "SCENARIO_COUNT=50 vitest run src/ultimate_proof.test.ts --silent=false --pool=forks --poolOptions.forks.singleFork=true",
    "ultimate:quick": "SCENARIO_COUNT=10 vitest run src/ultimate_proof.test.ts --silent=false --pool=forks --poolOptions.forks.singleFork=true",
    "build-manifest": "tsx scripts/build-manifest.ts",
    "ci": "npm run typecheck && npm run lint && npm run test && npm run build && npm run build-manifest"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/chrome": "^0.0.266",
    "@types/node": "^25.0.10",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.3.0",
    "tsx": "^4.21.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.54.0",
    "vite": "^5.4.0",
    "vitest": "^2.0.0"
  },
  "dependencies": {
    "@langchain/core": "^0.1.0",
    "@vercel/ai": "^3.0.0"
  }
}