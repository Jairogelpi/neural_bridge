{
  "name": "neural-bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/sdk/neural-bridge.cjs.js",
  "module": "./dist/sdk/neural-bridge.es.js",
  "types": "./dist/sdk/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/sdk/neural-bridge.es.js",
      "require": "./dist/sdk/neural-bridge.cjs.js",
      "types": "./dist/sdk/index.d.ts"
    }
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "npm run build:ext && npm run build:sdk",
    "build:ext": "vite build",
    "build:sdk": "vite build -c vite.sdk.config.ts && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "test": "vitest run --globals",
    "verify": "vitest run src/nbp_demo.test.ts src/offline_sovereignty.test.ts src/antifragile_demo.test.ts --globals",
    "build-manifest": "tsx scripts/build-manifest.ts",
    "server": "tsx src/server.ts",
    "ci": "npm run typecheck && npm run lint && npm run test && npm run build && npm run build-manifest"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/chrome": "^0.0.266",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.0.10",
    "@types/pg": "^8.16.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "jest": "^30.2.0",
    "prettier": "^3.3.0",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0",
    "vite": "^5.4.0",
    "vitest": "^2.0.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.93.3",
    "axios": "^1.13.4",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.18.0"
  },
  "optionalDependencies": {
    "@langchain/core": "^0.1.0"
  }
}
