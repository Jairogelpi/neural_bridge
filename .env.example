# ═══════════════════════════════════════════════════════════════
# PRODUCTION ENVIRONMENT VARIABLES
# ═══════════════════════════════════════════════════════════════

# Required: OpenRouter API Key
OPENROUTER_API_KEY=your_openrouter_key_here

# Required: Google AI API Key (for Gemini Vision - FREE!)
GOOGLE_AI_API_KEY=your_google_ai_key_here

# Database (Supabase or PostgreSQL)
DATABASE_URL=postgresql://user:password@host:5432/database
SUPABASE_URL=https://your_project.supabase.co
SUPABASE_ANON_KEY=your_anon_key

# Redis Cache (CRITICAL  for 1000x performance)
# Free tier: Redis Cloud (30MB free) or Upstash (10K commands/day free)
REDIS_URL=redis://localhost:6379
# Or for Redis Cloud: redis://default:password@redis-12345.c1.us-east-1-2.ec2.cloud.redislabs.com:12345

# OpenAI (for Whisper audio transcription)
OPENAI_API_KEY=your_openai_key_here

# Optional: Anthropic (if using Claude models)
ANTHROPIC_API_KEY=your_anthropic_key_here

# Server Configuration
PORT=3000
NODE_ENV=production
DASHBOARD_URL=https://your-dashboard.com

# Optional: Monitoring
SENTRY_DSN=https://your_sentry_dsn

# ═══════════════════════════════════════════════════════════════
# FREE TIER RECOMMENDATIONS
# ═══════════════════════════════════════════════════════════════
#
# Redis: Upstash (10K commands/day FREE) - https://upstash.com
#   OR: Redis Cloud (30MB FREE) - https://redis.com/try-free
#
# Gemini Vision: 1500 requests/day FREE - https://ai.google.dev
#
# Whisper:  $0.006/min (super cheap)
#
# Total monthly cost for 1000 users: ~$20-50
# ═══════════════════════════════════════════════════════════════
